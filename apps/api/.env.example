NODE_ENV=development
PORT=4000

DATABASE_URL="postgresql://postgres:123456@localhost:5432/oneops?schema=public"

JWT_SECRET=change-this-to-a-long-random-secret-in-production
JWT_EXPIRES_IN=7d

WS_CORS_ORIGIN=http://localhost:3000

# IP/Wifi hợp lệ của văn phòng (CIDR hoặc IP cụ thể, ngăn cách bằng dấu phẩy)
OFFICE_ALLOWED_IPS=192.168.1.0/24,127.0.0.1

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

REDIS_URL=redis://localhost:6379
