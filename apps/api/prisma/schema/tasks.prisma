model Task {
  id                 String         @id @default(uuid())
  title              String         @db.VarChar(150)
  description        String?        @db.Text
  assigneeId         String         @map("assignee_id")
  creatorId          String         @map("creator_id")
  deadline           DateTime
  status             TaskStatus     @default(todo)
  previousStatus     TaskStatus?    @map("previous_status")
  progress           Int            @default(0)
  priority           String         @default("medium")
  needsReassign      Boolean        @default(false) @map("needs_reassign")
  hasPendingProposal Boolean        @default(false) @map("has_pending_proposal")
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")

  assignee  User          @relation("TaskAssignee", fields: [assigneeId], references: [id])
  createdBy User          @relation("TaskCreator", fields: [creatorId], references: [id])
  histories TaskHistory[]
  logs      TaskLog[]
  proposals TaskProposal[]
  comments  TaskComment[]

  @@map("tasks")
  @@index([assigneeId])
  @@index([status])
  @@index([deadline])
}

model TaskHistory {
  id        String   @id @default(uuid())
  taskId    String   @map("task_id")
  actorId   String   @map("actor_id")
  type      String   @default("STATUS_CHANGE")
  oldValue  String?  @map("old_value")
  newValue  String   @map("new_value")
  reason    String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@map("task_histories")
  @@index([taskId])
  @@index([actorId])
}

model TaskLog {
  id          String     @id @default(uuid())
  taskId      String     @map("task_id")
  fromStatus  TaskStatus @map("from_status")
  toStatus    TaskStatus @map("to_status")
  changedById String     @map("changed_by_id")
  reason      String?
  createdAt   DateTime   @default(now()) @map("created_at")

  task      Task @relation(fields: [taskId], references: [id])
  changedBy User @relation(fields: [changedById], references: [id])

  @@map("task_logs")
  @@index([taskId])
}

model TaskProposal {
  id           String         @id @default(uuid())
  taskId       String         @map("task_id")
  userId       String         @map("user_id")
  type         ProposalType
  status       ProposalStatus @default(PENDING)
  reason       String         @db.Text
  reviewReason String?        @map("review_reason") @db.Text
  reviewerId   String?        @map("reviewer_id")
  createdAt    DateTime       @default(now()) @map("created_at")
  reviewedAt   DateTime?      @map("reviewed_at")

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])

  @@map("task_proposals")
  @@index([taskId])
  @@index([status])
}

model TaskComment {
  id          String   @id @default(uuid())
  taskId      String   @map("task_id")
  authorId    String   @map("author_id")
  content     String
  isSystemLog Boolean  @default(false) @map("is_system_log")
  createdAt   DateTime @default(now()) @map("created_at")

  task   Task @relation(fields: [taskId], references: [id])
  author User @relation(fields: [authorId], references: [id])

  @@map("task_comments")
  @@index([taskId])
}

enum TaskStatus {
  todo
  in_progress
  in_review
  rework
  postponed
  done
  cancelled
}

enum ProposalType {
  postpone
  cancel
}

enum ProposalStatus {
  PENDING
  APPROVED
  REJECTED
}
